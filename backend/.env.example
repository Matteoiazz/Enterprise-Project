# Copia questo file in ".env" (stessa cartella) e compila i valori.
# ".env" non va committato: viene letto automaticamente da docker-compose.

# IP della macchina che esegue Docker sulla propria rete locale (es. 192.168.1.x).
# Non e' un segreto: ognuno mette il PROPRIO IP, non quello di un compagno.
# Deve essere lo stesso IP configurato in frontend/local.properties (KEYCLOAK_IP)
# per l'app Android, altrimenti Keycloak e i servizi non si accordano sull'issuer
# del token JWT.
LOCAL_IP=

# Chiave condivisa per le chiamate interne tra microservizi (es. catalog-service
# <-> booking-service). Stessa per tutti i servizi e per tutti: chiedila al team.
INTERNAL_SERVICE_KEY=

# Credenziali Cloudinary (upload foto annunci/profilo) - account condiviso del team.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
