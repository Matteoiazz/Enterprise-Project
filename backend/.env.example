# Copia questo file in ".env" (stessa cartella, accanto a docker-compose.yml)
# e valorizza le variabili. Il file ".env" reale NON va mai committato (e'
# gia' escluso da .gitignore): contiene le credenziali che fanno davvero
# funzionare Cloudinary/Maps, non solo i placeholder di sviluppo.
#
# Vedi il README nella root del repository per la spiegazione di ogni voce
# e per come consegnare le chiavi reali al docente senza metterle su Git.

# --- Postgres (uno schema per servizio, stesso container Postgres per tutti) ---
DB_PASSWORD=password

# --- Keycloak (realm "tripify", importato automaticamente al primo avvio) ---
KEYCLOAK_ADMIN_USERNAME=admin
# user-auth-service usa queste credenziali (client "admin-cli" sul realm master)
# per sincronizzare nome/ruolo/attributi e per reset password / delete account.
# NON lasciare "admin": metti una password forte, la stessa che usi per entrare
# nella console Keycloak.
KEYCLOAK_ADMIN_PASSWORD=cambiami-con-una-password-forte

# URL pubblico HTTPS di Keycloak: il token porta questo host come "iss" e la
# validazione JWT fallisce se non combacia (vale per app e servizi backend).
# Serve HTTPS con hostname (non un IP): l'IdP Google rifiuta redirect in http/IP.
# OBBLIGATORIA: se e' vuota "docker compose up" si rifiuta di partire (senza,
# lo stack parte "verde" ma ogni chiamata autenticata torna 401).
#
# Due modi, in base a CLOUDFLARE_TUNNEL_TOKEN qui sotto:
#
#  A) tunnel "quick" (TOKEN vuoto): dopo il primo "up" leggi l'URL random da
#     "docker compose logs cloudflared", incollalo qui, rifai "up". CAMBIA a
#     ogni riavvio di cloudflared -> non riavviarlo durante la demo.
#
#  B) named tunnel STABILE (TOKEN valorizzato): metti il TUO hostname fisso,
#     es. https://keycloak.tuo-dominio.xyz . Non cambia mai: lo imposti una
#     volta qui, in frontend/local.properties (KEYCLOAK_IP) e nel redirect
#     Google, e non ci pensi piu'.
KEYCLOAK_PUBLIC_URL=

# Named tunnel Cloudflare (dominio statico). DUE modi:
#
#  MODO 1 - dashboard (serve un metodo di pagamento sul profilo, non addebita):
#   Cloudflare -> Zero Trust -> Networks -> Tunnels -> Create tunnel ->
#   "Cloudflared" -> nome -> copia il token -> Public Hostname
#   keycloak.tuo-dominio.xyz -> Service HTTP -> keycloak:8080. Incolla il token
#   qui sotto e metti KEYCLOAK_PUBLIC_URL=https://keycloak.tuo-dominio.xyz.
#
#  MODO 2 - da terminale, senza dashboard ne' carta (lascia CLOUDFLARE_TUNNEL_TOKEN VUOTO):
#   brew install cloudflared
#   cloudflared tunnel login                 # apri l'URL, scegli la tua zona, Authorize
#   cloudflared tunnel create tripify-keycloak
#   cloudflared tunnel route dns tripify-keycloak keycloak.tuo-dominio.xyz
#   cloudflared tunnel route dns tripify-keycloak api.tuo-dominio.xyz
#   cp ~/.cloudflared/<UUID>.json backend/cloudflared/
#   crea backend/cloudflared/config.yml con:
#     tunnel: <UUID>
#     credentials-file: /etc/cloudflared/<UUID>.json
#     ingress:
#       - hostname: keycloak.tuo-dominio.xyz
#         service: http://keycloak:8080
#       - hostname: api.tuo-dominio.xyz
#         service: http://api-gateway:8080
#       - service: http_status:404
#   poi KEYCLOAK_PUBLIC_URL=https://keycloak.tuo-dominio.xyz e, in
#   frontend/local.properties, BACKEND_IP=https://api.tuo-dominio.xyz.
#
#  Un solo tunnel copre sia Keycloak sia l'api-gateway (due hostname). Se lasci
#  vuoto CLOUDFLARE_TUNNEL_TOKEN e non c'e' backend/cloudflared/config.yml, parte
#  il tunnel "quick" con URL random (solo Keycloak).
CLOUDFLARE_TUNNEL_TOKEN=

# IP LAN della macchina: serve solo a booking-service per RabbitMQ nelle
# notifiche. Prendilo con "ipconfig getifaddr en0" (macOS) o "ipconfig" (Win).
LOCAL_IP=192.168.1.50

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Chiave di servizio condivisa tra booking-service e catalog-service ---
# (pattern saga per la compensazione degli hold: vedi PaymentGateway/
# CatalogClient.compensateHold in booking-service). Puo' essere una stringa
# qualsiasi concordata dal gruppo, non e' una credenziale di terzi - va solo
# essere IDENTICA su booking-service, catalog-service e communication-service.
# Obbligatoria: se la lasci vuota, "docker compose up" si rifiuta di avviare
# booking-service con un errore chiaro invece di partire con la compensazione
# degli hold rotta in silenzio (403 solo loggato, mai visto dall'utente).
INTERNAL_SERVICE_KEY=dev-internal-key

# --- Cloudinary (upload foto profilo/annunci, user-auth-service e catalog-service) ---
# Credenziali reali dell'account Cloudinary del gruppo: senza queste
# l'upload immagini non funziona, il resto dell'app si'.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting sul gateway (opzionale, ha gia' un default sensato) ---
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_MAX=3000
