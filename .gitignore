.idea/
.vscode/
.claude/
target/
build/
out/
*.class
.DS_Store
Thumbs.db
*.zip

# Dati grezzi Postgres del Keycloak locale (pg_wal, pg_multixact, ecc.) - non
# ha senso versionare un database, e la cartella sembra un residuo di una
# vecchia configurazione a bind mount (il docker-compose.yml attuale usa un
# volume Docker nominato, non questa cartella).
backend/keycloak-data/

# Cache locale di Gradle: tantissimi file piccoli che si rigenerano da soli
# ad ogni build, non ha senso versionarli e (soprattutto) fanno rallentare
# parecchio git status/add quando non sono esclusi, perche' li deve
# scansionare tutti ogni volta.
.gradle/

# Copie generate da iCloud quando il progetto sta sotto "Desktop e Documenti"
# (es. "Foo 2.java", "bar 3.kt"): non sono file reali del progetto e mandano
# in errore la compilazione con "duplicate class".
* [0-9].*
* [0-9]
*\ copy
*\ copy.*

# Variabili d'ambiente reali del backend (credenziali Cloudinary, chiavi
# interne, ecc.): solo backend/.env.example va versionato, mai il .env vero.
backend/.env

# Log locale generato lanciando la build di booking-service a mano.
backend/booking-service/booking-log.txt
