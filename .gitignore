.idea/
.vscode/
.claude/
target/
build/
out/
*.class
.DS_Store
Thumbs.db
*.zip

# Valori reali delle variabili d'ambiente per docker-compose (IP locale, chiavi
# Cloudinary, internal service key): solo backend/.env.example va committato.
backend/.env

# Dati grezzi Postgres del Keycloak locale (pg_wal, pg_multixact, ecc.) - non
# ha senso versionare un database, e la cartella sembra un residuo di una
# vecchia configurazione a bind mount (il docker-compose.yml attuale usa un
# volume Docker nominato, non questa cartella).
backend/keycloak-data/

# Cache locale di Gradle: tantissimi file piccoli che si rigenerano da soli
# ad ogni build, non ha senso versionarli e (soprattutto) fanno rallentare
# parecchio git status/add quando non sono esclusi, perche' li deve
# scansionare tutti ogni volta.
.gradle/

# Copie generate da iCloud quando il progetto sta sotto "Desktop e Documenti"
# (es. "Foo 2.java", "bar 3.kt"): non sono file reali del progetto e mandano
# in errore la compilazione con "duplicate class".
* [0-9].*
* [0-9]
*\ copy
*\ copy.*

# Variabili d'ambiente reali del backend (credenziali Cloudinary, chiavi
# interne, ecc.): solo backend/.env.example va versionato, mai il .env vero.
.env
backend/.env

# Realm Keycloak con i segreti reali dentro (password SMTP Gmail, client
# secret Google): va consegnato fuori da Git come .env. Versionato solo il
# template backend/keycloak-import.example.json (segreti = CHANGEME).
# Il pattern puntava prima a "realm-export-4.json", un nome mai esistito
# davvero: il file vero si chiama "realm-export.json" e non veniva escluso.
backend/keycloak-import/realm-export.json

# Tuning locale delle risorse (mem_limit, -Xmx) per la VM di Docker Desktop.
# Non committato: ognuno lo tara sulla propria macchina.
backend/docker-compose.override.yml

# Credenziali del named tunnel Cloudflare creato da terminale (config.yml +
# <UUID>.json col TunnelSecret). Non committare: e' un segreto dell'account.
backend/cloudflared/

# Log locale generato lanciando la build di booking-service a mano.
backend/booking-service/booking-log.txt
